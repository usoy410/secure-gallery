# Python virtual environments
.venv/
venv/
ENV/
env/
uv.lock

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Python packaging artifacts
*.egg-info/
dist/
build/
eggs/
.eggs/

# Android / Gradle caches and artifacts
.gradle/
*/build/

# IDE / OS caches
.DS_Store
Thumbs.db
.idea/
.vscode/

# Data directory (synthetic generation and raw data must not be committed)
/data/
data/
# ...but the Android app's Room package is source code
!android/app/src/**/data/

# Model weights and training outputs
/runs/
runs/
*.pt
*.tflite
*.onnx
# ...except the detector the app ships (stored with Git LFS, see .gitattributes)
!android/app/src/main/assets/detector.tflite

# Block image files everywhere by default (hard rule: never commit real ID or card images)
*.jpg
*.jpeg
*.png
*.heic

# Whitelist allowed image locations (android test snapshots and templates)
!android/**/src/test/**
# Synthetic detector fixtures for the emulator test (generated by ml.android_fixtures)
!android/app/src/androidTest/assets/fixtures/*.jpg
# Synthetic redaction fixtures for the emulator test (generated by ml.android_redaction_fixtures)
!android/app/src/androidTest/assets/redaction/*.jpg
!templates/**
# Evaluation charts (plots only, never card images)
!reports/**/*.png
# RQ4 example gallery: synthetic benchmark cards only, size-capped by a test
!reports/rq4/examples/*.jpg

# Re-ignore Python caches inside the whitelisted paths above (later rules win)
**/__pycache__/
*.py[cod]

# Sample datasets Ultralytics downloads during export
/datasets/
